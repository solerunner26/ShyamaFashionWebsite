{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!products/|editorial/|catalog/|assets/|favicon\\.svg|apple-touch-icon\\.png|icon-.*\\.png|manifest\\.webmanifest|sw\\.js).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(products|editorial)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
